---
import '../styles/global.css';
import profile from '../data/profile.json';
import sectors from '../data/sectors.json';
import brief from '../data/brief.json';
const site = {
  typedBrief: profile.typedBrief,
  sectorCount: sectors.sectors.length,
  radarDone: sectors.radarCenterDone,
  apiEndpoint: brief.apiEndpoint || '/api/brief',
  metricsEndpoint: brief.metricsEndpoint || '/api/metrics',
  chatEndpoint: brief.chatEndpoint || '/api/chat',
  bookingsUrl: brief.bookingsUrl || '',
  analytics: {
    firstPartyEnabled: (import.meta.env.PUBLIC_FIRST_PARTY_ANALYTICS || 'true') !== 'false',
    googleAnalyticsId: import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID || '',
    clarityProjectId: import.meta.env.PUBLIC_MICROSOFT_CLARITY_ID || ''
  }
};
const { title = profile.name + ' · The Build Log' } = Astro.props;

// All SEO/social meta derives from profile.json so a fork gets correct tags by
// swapping content, never touching the layout. metaDescription is optional and
// falls back to the subject line.
const siteUrl = 'https://' + (profile.domain || 'example.com');
const description = (profile.metaDescription || profile.subjectLine || '').replace(/&amp;/g, '&');
// og.png is a static 1200x630 card checked into public/. If the name or subject
// line changes, regenerate it from scripts/og-card.html (instructions in that file).
const ogImage = siteUrl + '/og.png?v=ad-logo';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: siteUrl,
  jobTitle: (profile.subjectLine || '').replace(/&amp;/g, '&'),
  sameAs: (profile.channels || []).map(c => c.url),
  ...(profile.firm?.name ? { worksFor: { '@type': 'Organization', name: profile.firm.name, url: profile.firm.url } } : {})
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={siteUrl + '/'}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta property="og:type" content="website">
  <meta property="og:url" content={siteUrl + '/'}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(person)}></script>
  {site.analytics.googleAnalyticsId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.googleAnalyticsId}`}></script>
      <script is:inline set:html={`
        window.dataLayer=window.dataLayer||[];
        function gtag(){dataLayer.push(arguments);}
        gtag('js',new Date());
        gtag('config',${JSON.stringify(site.analytics.googleAnalyticsId)},{anonymize_ip:true});
      `}></script>
    </>
  )}
  {site.analytics.clarityProjectId && (
    <script is:inline set:html={`
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script",${JSON.stringify(site.analytics.clarityProjectId)});
    `}></script>
  )}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <script is:inline set:html={`window.__SITE=${JSON.stringify(site)};`}></script>
</head>
<body data-theme="cyan">
  <div class="themes" aria-label="Theme color">
    <span>Signal</span>
    <button class="tbtn cy on" type="button" data-t="cyan" aria-label="Use cyan theme"></button>
    <button class="tbtn gr" type="button" data-t="green" aria-label="Use green theme"></button>
    <button class="tbtn am" type="button" data-t="amber" aria-label="Use amber theme"></button>
  </div>
  <slot />
  <script src="../scripts/main.js"></script>
  <script src="../scripts/chat.js"></script>
</body>
</html>
