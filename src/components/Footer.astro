---
import profile from '../data/profile.json';

const channelPriority = (url) => {
  if (url.includes('linkedin.com')) return 0;
  if (url.includes('github.com')) return 1;
  return 2;
};
const channels = [...(profile.channels || [])].sort(
  (a, b) => channelPriority(a.url) - channelPriority(b.url)
);
const subject = (profile.subjectLine || '').replaceAll('&amp;', '&');
const channelIcon = (channel) => {
  const value = `${channel.url} ${channel.label}`.toLowerCase();
  if (value.includes('linkedin')) return 'linkedin';
  if (value.includes('github')) return 'github';
  if (value.includes('instamapp')) return 'instamapp';
  if (value.includes('dcosmos')) return 'dcosmos';
  return 'external';
};
const channelItems = channels.map((channel) => ({
  ...channel,
  icon: channelIcon(channel)
}));
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/favicon.svg" alt="" aria-hidden="true">
      <div>
        <span class="footer-kicker">End of file // Open channels</span>
        <strong>{profile.name}</strong>
        <span class="footer-subject">{subject}</span>
      </div>
    </div>
    <nav class="footer-links" aria-label="Social and project links">
      {channelItems.map(channel => (
        <a href={channel.url} target="_blank" rel="noopener noreferrer" aria-label={channel.label} title={channel.label}>
          {channel.icon === 'linkedin' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.55V9h3.57v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0Z" />
            </svg>
          )}
          {channel.icon === 'github' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 .3C5.37.3 0 5.67 0 12.3c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.66-.3-5.46-1.33-5.46-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.3c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.3C24 5.67 18.63.3 12 .3Z" />
            </svg>
          )}
          {channel.icon === 'instamapp' && <img src="/icons/instamapp.svg" alt="" aria-hidden="true" loading="lazy">}
          {channel.icon === 'dcosmos' && <img src="/icons/dcosmos.ico" alt="" aria-hidden="true" loading="lazy">}
          {channel.icon === 'external' && <span aria-hidden="true">GO</span>}
        </a>
      ))}
    </nav>
  </div>
  <div class="footer-meta">
    <span>&copy; {new Date().getFullYear()} {profile.name}</span>
    <span>Custom-built by Andrew DiCosmo. Public engine, private content pipeline.</span>
    {profile.firm?.name && <span>{profile.firm.name}</span>}
  </div>
</footer>
