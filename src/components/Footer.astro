---
import profile from '../data/profile.json';

const channelPriority = (url) => {
  if (url.includes('linkedin.com')) return 0;
  if (url.includes('github.com')) return 1;
  return 2;
};
const channels = [...(profile.channels || [])].sort(
  (a, b) => channelPriority(a.url) - channelPriority(b.url)
);
const subject = (profile.subjectLine || '').replaceAll('&amp;', '&');
const channelIcon = (channel) => {
  const value = `${channel.url} ${channel.label}`.toLowerCase();
  if (value.includes('linkedin')) return 'in';
  if (value.includes('github')) return 'GH';
  if (value.includes('instamapp')) return 'IM';
  if (value.includes('dcosmos')) return 'AD';
  return 'GO';
};
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/favicon.svg" alt="" aria-hidden="true">
      <div>
        <span class="footer-kicker">End of file // Open channels</span>
        <strong>{profile.name}</strong>
        <span class="footer-subject">{subject}</span>
      </div>
    </div>
    <nav class="footer-links" aria-label="Social and project links">
      {channels.map(channel => (
        <a href={channel.url} target="_blank" rel="noopener noreferrer" aria-label={channel.label} title={channel.label}>
          <span aria-hidden="true">{channelIcon(channel)}</span>
        </a>
      ))}
    </nav>
  </div>
  <div class="footer-meta">
    <span>&copy; {new Date().getFullYear()} {profile.name}</span>
    <span>Custom-built by Andrew DiCosmo. Public engine, private content pipeline.</span>
    {profile.firm?.name && <span>{profile.firm.name}</span>}
  </div>
</footer>
