---
import brief from '../data/brief.json';
import profile from '../data/profile.json';
const firm = profile.firm;
---
<section class="contact" id="contact">
  <h2 class="sec-title">Choose Your <span>Engagement</span></h2>
  <div class="sec-sub">ONE INQUIRY · SELECT ONE OR MORE PATHS, AND IT BUILDS ITSELF</div>
  <p class="engagement-note"><Fragment set:html={brief.availability} /> <span>·</span> <Fragment set:html={brief.terms} /></p>

  <div class="door-panel brief-panel" id="brief" style="margin-top:0;max-width:1100px">
    <div class="dp-tag">Transmit · Engagement inquiry</div>
    <h3 id="brief-title">Engagement Inquiry</h3>

    <div class="step-lbl">01 · Path</div>
    <div class="path-row">
      <div class="pathcard" id="door-hire" onclick="toggleDoor('w2')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleDoor('w2')}" role="button" tabindex="0" aria-pressed="false">
        <span class="dsel" id="dsel-w2">Tap to select</span>
        <div class="pc-tag">Path 01 · Full-Time</div>
        <h4>Leadership or Engineering</h4>
        <p>CTO, VP Engineering, technology leadership, or senior hands-on engineering as a W-2 hire. The resume lands in your inbox when you transmit.</p>
      </div>
      <div class="pathcard" id="door-firm" onclick="toggleDoor('c2c')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleDoor('c2c')}" role="button" tabindex="0" aria-pressed="false">
        <span class="dsel" id="dsel-c2c">Tap to select</span>
        <div class="pc-tag">Path 02 · Consulting</div>
        <h4>Work With Me, C2C</h4>
        <p>You engage me, not a company. The work runs through my firm, <a href={firm.url} onclick="event.stopPropagation()" style="color:var(--ac);text-decoration:none;border-bottom:1px solid var(--ac-dim)">{firm.name.split(',')[0]}</a>: cloud, security, and AI engineering.</p>
      </div>
      <div class="pathcard" id="door-leadership" onclick="toggleDoor('cto')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleDoor('cto')}" role="button" tabindex="0" aria-pressed="false">
        <span class="dsel" id="dsel-cto">Tap to select</span>
        <div class="pc-tag">Path 03 · Technology Leadership</div>
        <h4>Fractional / Interim</h4>
        <p>Set the strategy and roadmap, establish engineering and governance practices, and lead delivery with hands-on depth. W-2 and C2C arrangements are supported.</p>
      </div>
    </div>

    <div class="brief-empty" id="brief-empty">Select a path above and <b>the inquiry builds itself</b></div>
    <div class="cform" id="brief-form" style="display:none">
      <div class="step-lbl" style="margin-top:2px">02 · Parameters</div>
      <div class="fs" id="fs-w2">
        <div class="f2" style="margin-bottom:10px">
          <div><label>W-2 compensation range</label>
          <select>{brief.salary.map(o => <option>{o}</option>)}</select></div>
          <div><label>Job details · link or file · optional but helpful</label>
          <div class="fattach" id="job-requirement">
            <input type="url" id="jr-link" placeholder="LINK TO THE JOB REQ">
            <input type="file" id="jrfile" accept=".pdf,.doc,.docx" style="display:none" onchange="jrPicked(this)">
            <button type="button" class="fbtn" id="jrbtn" onclick="document.getElementById('jrfile').click()">Attach PDF / DOC</button>
          </div></div>
        </div>
      </div>
      <div class="fs" id="fs-c2c">
        <div class="f2" style="margin-bottom:10px">
          <div><label>Estimated budget</label>
          <select>{brief.budget.map(o => <option>{o}</option>)}</select></div>
          <div><label>Term</label>
          <select>{brief.term.map(o => <option>{o}</option>)}</select></div>
        </div>
        <div style="margin-bottom:10px"><label>What kind of work · tap all that fit</label>
        <div class="pchips" id="work-areas">
          {brief.chips.map(c => <button type="button" class="pchip" onclick="this.classList.toggle('on')">{c}</button>)}
        </div></div>
        <div style="max-width:340px"><label>Where the project stands</label>
        <select>{brief.stage.map(o => <option>{o}</option>)}</select></div>
      </div>
      <div class="fs" id="fs-cto">
        <div style="max-width:440px;margin-bottom:10px"><label>Leadership arrangement</label>
        <select>{brief.leadershipArrangement.map(o => <option>{o}</option>)}</select></div>
      </div>
      <div class="step-lbl">03 · Transmit</div>
      <div class="f2">
        <div><label>Name · required</label><input type="text" id="bname" placeholder="NAME"></div>
        <div><label>Work email · required</label><input type="email" id="bemail" placeholder="EMAIL"></div>
      </div>
      <div class="f2">
        <div><label>Company · required</label><input type="text" id="bcompany" placeholder="COMPANY"></div>
        <div><label>Your role · required</label><input type="text" id="brole" placeholder="ROLE / TITLE"></div>
      </div>
      <div><label id="bmsg-label">Additional context</label>
      <textarea id="bmsg" minlength="40" placeholder=""></textarea></div>
      <div class="form-errors" id="brief-errors" role="alert" hidden></div>
      <button class="door primary" type="button" onclick="sendBrief()">Transmit · Receive the resume</button>
      <p class="form-note">A complete inquiry sends me your details and sends <b>the resume (PDF)</b> to your email. I reply within one business day.</p>
    </div>
    <div class="brief-success" id="brief-done">
      <div class="bs-code">Transmission received</div>
      <h4>Resume Inbound</h4>
      <p>Check your inbox. The ATS friendly resume is on its way, and I will follow up on your inquiry within one business day. If it does not arrive, check spam or write me directly.</p>
      <div id="sched-wrap" style="display:none;margin-top:18px">
        <p style="margin-bottom:12px">Your inquiry has <b style="color:var(--ac)">everything I need</b>. If you want to move fast, skip the email round trip and grab a time now.</p>
        <a class="door primary" href="#" style="display:inline-block;text-decoration:none">Schedule a call · Pick a time</a>
      </div>
    </div>
  </div>
</section>
