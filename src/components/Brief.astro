---
import brief from '../data/brief.json';
import profile from '../data/profile.json';
const firm = profile.firm;
---
<section class="contact" id="contact">
  <h2 class="sec-title">Choose Your <span>Engagement</span></h2>
  <div class="sec-sub">SELECT ONE OR MORE OPTIONS · THE FORM ADAPTS TO YOUR NEEDS</div>
  <p class="engagement-note"><Fragment set:html={brief.availability} /> <span>·</span> <Fragment set:html={brief.terms} /></p>

  <div class="door-panel brief-panel" id="brief" style="margin-top:0;max-width:1100px">
    <div class="dp-tag">Start here · Engagement inquiry</div>
    <h3 id="brief-title">How Would You Like to Work Together?</h3>

    <div class="step-lbl">01 · Choose one or more options</div>
    <div class="path-row">
      <div class="pathcard" id="door-hire" onclick="toggleDoor('w2')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleDoor('w2')}" role="button" tabindex="0" aria-pressed="false">
        <div class="pathcard-head">
          <div class="pc-tag">Path 01 · Full-Time Role</div>
          <span class="dsel" id="dsel-w2">Select</span>
        </div>
        <h4>Hire Me Full-Time</h4>
        <p>For a permanent role in AI engineering, cloud, security, architecture, or hands-on technology delivery.</p>
        <div class="path-resume"><span>Resume</span><b>Engineering &amp; Delivery</b></div>
      </div>
      <div class="pathcard" id="door-firm" onclick="toggleDoor('c2c')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleDoor('c2c')}" role="button" tabindex="0" aria-pressed="false">
        <div class="pathcard-head">
          <div class="pc-tag">Path 02 · Consulting Project</div>
          <span class="dsel" id="dsel-c2c">Select</span>
        </div>
        <h4>Engage My Firm</h4>
        <p>For a project or ongoing consulting engagement delivered directly through {firm.name.split(',')[0]}.</p>
        <div class="path-resume"><span>Resume</span><b>Engineering &amp; Delivery</b></div>
      </div>
      <div class="pathcard" id="door-leadership" onclick="toggleDoor('cto')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleDoor('cto')}" role="button" tabindex="0" aria-pressed="false">
        <div class="pathcard-head">
          <div class="pc-tag">Path 03 · Technology Leadership</div>
          <span class="dsel" id="dsel-cto">Select</span>
        </div>
        <h4>CTO / Technology Leadership</h4>
        <p>For full-time, fractional, or interim leadership to set strategy, guide teams, strengthen governance, and improve delivery.</p>
        <div class="path-resume"><span>Resume</span><b>Technology Executive</b></div>
      </div>
    </div>

    <div class="brief-empty" id="brief-empty">Select one or more options above to continue.</div>
    <div class="cform" id="brief-form" style="display:none">
      <div class="step-lbl" style="margin-top:2px">02 · Opportunity details</div>
      <div class="fs" id="fs-w2">
        <div class="form-path-title">Full-Time Role</div>
        <div class="f2" style="margin-bottom:10px">
          <div><label>Expected annual salary</label>
          <select>{brief.salary.map(o => <option>{o}</option>)}</select></div>
          <div><label>Job description · optional</label>
          <div class="fattach" id="job-requirement">
            <input type="url" id="jr-link" placeholder="PASTE A LINK TO THE JOB POSTING">
            <input type="file" id="jrfile" accept=".pdf,.doc,.docx" style="display:none" onchange="jrPicked(this)">
            <button type="button" class="fbtn" id="jrbtn" onclick="document.getElementById('jrfile').click()">Attach job description</button>
          </div></div>
        </div>
      </div>
      <div class="fs" id="fs-c2c">
        <div class="form-path-title">Consulting Project</div>
        <div class="f2" style="margin-bottom:10px">
          <div><label>Estimated project budget</label>
          <select>{brief.budget.map(o => <option>{o}</option>)}</select></div>
          <div><label>Expected project length</label>
          <select>{brief.term.map(o => <option>{o}</option>)}</select></div>
        </div>
        <div style="margin-bottom:10px"><label>What help do you need? · Select all that apply</label>
        <div class="pchips" id="work-areas">
          {brief.chips.map(c => <button type="button" class="pchip" onclick="this.classList.toggle('on')">{c}</button>)}
        </div></div>
        <div style="max-width:440px"><label>Current project stage</label>
        <select>{brief.stage.map(o => <option>{o}</option>)}</select></div>
      </div>
      <div class="fs" id="fs-cto">
        <div class="form-path-title">Technology Leadership</div>
        <div style="max-width:440px;margin-bottom:10px"><label>Preferred leadership arrangement</label>
        <select>{brief.leadershipArrangement.map(o => <option>{o}</option>)}</select></div>
      </div>
      <div class="step-lbl">03 · About you</div>
      <div class="resume-match">
        <span>Resume you will receive</span>
        <b id="resume-match-name">Engineering &amp; Delivery Resume</b>
      </div>
      <div class="f2">
        <div><label>Your name · required</label><input type="text" id="bname" autocomplete="name" placeholder="YOUR NAME"></div>
        <div><label>Email address · required</label><input type="email" id="bemail" autocomplete="email" placeholder="YOUR EMAIL"></div>
      </div>
      <div class="f2">
        <div><label>Company or organization · required</label><input type="text" id="bcompany" autocomplete="organization" placeholder="COMPANY OR ORGANIZATION"></div>
        <div><label>Your title or role · required</label><input type="text" id="brole" autocomplete="organization-title" placeholder="YOUR TITLE OR ROLE"></div>
      </div>
      <div><label id="bmsg-label">Additional context</label>
      <textarea id="bmsg" minlength="40" aria-describedby="bmsg-help" placeholder=""></textarea>
      <span class="field-help" id="bmsg-help">Please provide at least 40 characters so I have enough context to respond.</span></div>
      <div class="form-errors" id="brief-errors" role="alert" hidden></div>
      <button class="door primary" id="brief-submit" type="button" onclick="sendBrief()">Send inquiry · Receive the resume</button>
      <p class="form-note">After you submit the form, the <b>resume shown above</b> will be emailed to you. I respond personally within one business day.</p>
    </div>
    <div class="brief-success" id="brief-done">
      <div class="bs-code">Inquiry received</div>
      <h4 id="brief-success-title">Check Your Inbox</h4>
      <p id="brief-success-copy">The resume selected for your inquiry is on its way. I will review your message and respond personally within one business day.</p>
      <div id="sched-wrap" style="display:none;margin-top:18px">
        <p style="margin-bottom:12px">Your inquiry includes everything I need. You can also schedule a call now.</p>
        <a class="door primary" href="#" style="display:inline-block;text-decoration:none">Schedule a call</a>
      </div>
    </div>
  </div>
</section>
