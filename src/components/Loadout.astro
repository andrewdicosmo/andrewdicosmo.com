---
import loadout from '../data/loadout.json';
import head from '../data/sections/CAPS_HEAD.html?raw';
const close = '</section>';
---
<Fragment set:html={head} />
  <div class="cap-grid">
    {loadout.cards.map(c => (
      <div class="cap"><div class="cap-code">{c.code}</div><h4><Fragment set:html={c.title} /></h4>
        <div class="chips">{c.chips.map(ch => <span class="chip"><Fragment set:html={ch} /></span>)}</div></div>
    ))}
  </div>
<Fragment set:html={close} />
