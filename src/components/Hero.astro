---
// Cargo: the hero section html lives in src/data (private). {{SUBJECT_SRC}} is replaced with the bundled photo.
import raw from '../data/sections/HERO.html?raw';
import profile from '../data/profile.json';
const imgs = import.meta.glob('../data/assets/subject.webp', { eager: true, query: '?url', import: 'default' });
const subject = Object.values(imgs)[0] || 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="500"><rect width="400" height="500" fill="%23222"/><text x="200" y="260" fill="%23888" font-family="monospace" font-size="16" text-anchor="middle">ADD subject.webp</text></svg>';
const availability = profile.availability || {};
const status = availability.status === 'engaged' ? 'engaged' : 'available';
const activeLabel = status === 'engaged' ? 'ENGAGED' : 'AVAILABLE';
const availabilityLine = availability.line || (status === 'engaged' ? 'Future conversations welcome' : 'W-2 or C2C · Start quickly');
const availableFrom = availability.availableFrom ? `<span class="status-window">${availability.availableFrom}</span>` : '';
const html = raw
  .replaceAll('{{SUBJECT_SRC}}', subject)
  .replaceAll('{{AVAILABILITY_STATUS}}', status)
  .replaceAll('{{AVAILABLE_ACTIVE}}', status === 'available' ? 'active' : '')
  .replaceAll('{{ENGAGED_ACTIVE}}', status === 'engaged' ? 'active' : '')
  .replaceAll('{{ACTIVE_STATUS_LABEL}}', activeLabel)
  .replaceAll('{{AVAILABILITY_LINE}}', availabilityLine)
  .replaceAll('{{AVAILABILITY_WINDOW}}', availableFrom);
---
<Fragment set:html={html} />
