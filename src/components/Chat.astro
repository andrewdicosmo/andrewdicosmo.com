<div class="chat-shell" data-chat-state="closed">
  <button class="chat-launcher" id="chat-launcher" type="button" aria-haspopup="dialog" aria-controls="chat-panel" aria-expanded="false">
    <span class="chat-launcher-signal" aria-hidden="true"></span>
    <span>Ask Andrew's AI</span>
  </button>

  <section class="chat-panel" id="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
    <header class="chat-header">
      <div>
        <span class="chat-kicker">Comms link // Online</span>
        <h2 id="chat-title">Andrew's AI Assistant</h2>
      </div>
      <button class="chat-icon-button" id="chat-close" type="button" aria-label="Close AI Assistant" title="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </header>

    <div class="chat-status" id="chat-status" role="status" aria-live="polite">
      <span aria-hidden="true"></span> Secure channel ready
    </div>

    <div class="chat-messages" id="chat-messages" role="log" aria-live="polite" aria-relevant="additions"></div>
    <div class="chat-choices" id="chat-choices" aria-label="Conversation starters"></div>

    <form class="chat-composer" id="chat-form">
      <label class="sr-only" for="chat-input">Message Andrew's AI Assistant</label>
      <textarea id="chat-input" rows="1" maxlength="1200" placeholder="Ask about Andrew's experience..." required></textarea>
      <button type="submit" class="chat-send" aria-label="Send message" title="Send">
        <span aria-hidden="true">&#8593;</span>
      </button>
    </form>

    <footer class="chat-footer">
      <span>AI responses may need verification.</span>
      <button type="button" id="chat-privacy-open" aria-expanded="false">Privacy</button>
      <div class="chat-privacy" id="chat-privacy" role="dialog" aria-label="Chat privacy" hidden>
        <button type="button" id="chat-privacy-close" aria-label="Close privacy notice">&times;</button>
        Chats may be reviewed by Andrew, processed by Azure AI and web search, and automatically deleted after 30 days.
      </div>
    </footer>
  </section>
</div>
