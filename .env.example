# Frontend needs nothing secret. These are AZURE FUNCTION APP SETTINGS,
# set in the Static Web App's configuration, never committed.

# Azure Storage account (leads table + attachments container + resume blob)
STORAGE_CONNECTION_STRING=
LEADS_TABLE=leads
ATTACH_CONTAINER=briefs

# Outbound mail (SendGrid) for delivering the resume + notifying you
SENDGRID_API_KEY=
MAIL_FROM=you@yourdomain.com
MAIL_TO=you@yourdomain.com

# Private URL (SAS) to the ATS resume PDF in blob storage
RESUME_BLOB_URL=

# Scheduler link offered after a complete brief (Microsoft Bookings or Calendly)
BOOKINGS_URL=
